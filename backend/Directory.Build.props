<Project>
  <!-- Ajustes de compilacion compartidos por todos los proyectos backend. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Auditar solo dependencias DIRECTAS: una vuln transitiva (p.ej. Microsoft.OpenApi via
         AspNetCore.OpenApi) no debe romper el build via TreatWarningsAsErrors. Tus deps directas si se auditan. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>